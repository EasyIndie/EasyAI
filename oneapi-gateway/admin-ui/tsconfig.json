{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@easyai/ui": ["../shared-ui/src/index"],
      "@easyai/ui/*": ["../shared-ui/src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"]
}
